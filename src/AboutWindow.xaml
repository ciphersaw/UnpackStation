<Window x:Class="UnpackStation.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About UnpackStation"
        Width="560" Height="460"
        MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="UnpackStation" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            <TextBlock Margin="0,6,0,0" Text="Extracts installer packages to a chosen directory without running the installer."
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,0" Padding="12"
                BorderThickness="1" CornerRadius="4"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Supported package formats and engines" FontWeight="SemiBold" Margin="0,0,0,8"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                               Text="Inno Setup (.exe): bundled innoextract 1.13.0 reads the installer data directly; the setup is never run." />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                               Text="NSIS, CAB SFX, 7z, ZIP and other archive SFX (.exe): bundled 7z.dll detects the format by content signature." />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                               Text="Windows Installer (.msi): the system msiexec /a administrative install (no bundled engine)." />
                    <TextBlock Text="7-Zip License Notice (LGPL)" FontWeight="SemiBold" Margin="0,0,0,8"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                               Text="1. This software uses part of 7-Zip (7z.dll) via dynamic loading only; it does not install or register 7-Zip." />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                               Text="2. 7-Zip is licensed under the GNU LGPL (some code is subject to the unRAR restriction or uses the BSD license)." />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                               Text="3. The 7-Zip source code is available at www.7-zip.org." />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Text="The shipped engines/7z/License.txt governs binary redistribution of 7z.dll." />
                    <TextBlock Text="innoextract License Notice (zlib/libpng)" FontWeight="SemiBold" Margin="0,0,0,8"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                               Text="1. Inno Setup extraction uses the bundled innoextract 1.13.0 via a child process; it is not innounp." />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                               Text="2. innoextract is licensed under the zlib/libpng license (permissive, not GPL/AGPL)." />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                               Text="3. Source: github.com/crazy-max/innoextract (fork of Daniel Scharrer's innoextract); the shipped engines/innoextract/LICENSE.txt is authoritative." />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Text="This tool does not use innounp (GPLv3), does not copy UniExtract2 code, and introduces no GPL/AGPL dependencies." />
                    <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                               Text="Security note: extracted executables are tagged with Mark of the Web; the program always runs with normal privileges and never automatically runs any extracted program." />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Width="140" Height="28" Content="View 7-Zip License" Click="Open7zLicense_Click" />
            <Button Width="160" Height="28" Margin="10,0,0,0" Content="View innoextract License" Click="OpenInnoextractLicense_Click" />
            <Button Width="80" Height="28" Margin="10,0,0,0" Content="Close" IsCancel="True" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
