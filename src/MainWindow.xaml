<Window x:Class="UnpackStation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UnpackStation"
        Width="900" Height="600"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Top half: drag-and-drop target -->
            <RowDefinition Height="1.05*" MinHeight="170" />
            <!-- File info, output directory, buttons -->
            <RowDefinition Height="Auto" />
            <!-- Progress bar -->
            <RowDefinition Height="Auto" />
            <!-- Log header -->
            <RowDefinition Height="Auto" />
            <!-- Bottom half: log area -->
            <RowDefinition Height="0.95*" MinHeight="130" />
        </Grid.RowDefinitions>

        <Border x:Name="DropZone"
                Grid.Row="0"
                AllowDrop="True"
                Cursor="Hand"
                BorderThickness="2"
                CornerRadius="6"
                Padding="12"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"
                DragEnter="DropZone_DragEnter"
                DragOver="DropZone_DragOver"
                DragLeave="DropZone_DragLeave"
                Drop="DropZone_Drop"
                MouseLeftButtonUp="DropZone_MouseLeftButtonUp">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="Drop an installer package here, or click to choose a file"
                           FontSize="20" HorizontalAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                <TextBlock Text="Supports .exe / .msi"
                           FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="File:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="{Binding FileInfoText}" ToolTip="{Binding FileInfoText}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="Output to:" VerticalAlignment="Center" Margin="0,8,8,0" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,8,0" Padding="4,3"
                     Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEditPaths}"
                     ToolTip="Editable; resets to the default directory when a new file is selected" />
            <Button Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" Padding="14,3"
                    Content="Browse" Click="BrowseOutput_Click"
                    IsEnabled="{Binding CanEditPaths}" />

            <StackPanel Grid.Row="2" Grid.ColumnSpan="3"
                        Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <Button Width="120" Height="30" Content="Start extraction"
                        Command="{Binding StartCommand}" />
                <Button Width="80" Height="30" Margin="12,0,0,0" Content="Cancel"
                        Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}" />
                <Button Width="120" Height="30" Margin="12,0,0,0" Content="Open output directory"
                        Command="{Binding OpenOutputCommand}" />
                <Button Width="70" Height="30" Margin="12,0,0,0" Content="About"
                        Click="About_Click" />
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="{Binding StatusText}"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <ProgressBar Height="16" Minimum="0" Maximum="100"
                         Value="{Binding ProgressValue, Mode=OneWay}"
                         IsIndeterminate="{Binding IsProgressIndeterminate}" />
        </DockPanel>

        <DockPanel Grid.Row="3" Margin="0,14,0,6">
            <Button DockPanel.Dock="Right" Padding="12,2" Content="Copy diagnostic information"
                    Command="{Binding CopyDiagnosticCommand}"
                    ToolTip="Copy the full technical details of this extraction to the clipboard" />
            <TextBlock Text="Log" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        </DockPanel>

        <TextBox x:Name="LogBox"
                 Grid.Row="4"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 FontFamily="Consolas"
                 FontSize="12"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"
                 Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                 Text="{Binding LogText, Mode=OneWay}"
                 TextChanged="LogBox_TextChanged" />
    </Grid>
</Window>
