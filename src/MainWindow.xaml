<Window x:Class="UnpackStation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UnpackStation"
        Width="860" Height="560"
        MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

    <Window.Resources>
        <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E8ECF1" />
        <Style x:Key="ThemedProgressBarStyle" TargetType="{x:Type ProgressBar}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="TrackBorder"
                                    Background="{StaticResource ProgressTrackBrush}"
                                    BorderBrush="#D3D9E0" BorderThickness="1"
                                    CornerRadius="9" ClipToBounds="True" />
                            <Grid Margin="2">
                                <Rectangle x:Name="PART_Track" Fill="Transparent" />
                                <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                    <Border CornerRadius="7">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#0078D4" Offset="0" />
                                                <GradientStop Color="#3FA0E8" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Decorator>
                            </Grid>
                            <TextBlock Text="{TemplateBinding Tag}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                                       IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="TrackBorder" Property="BorderBrush" Value="#BBD3E8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- Compact drop target -->
            <RowDefinition Height="Auto" />
            <!-- Package info card -->
            <RowDefinition Height="Auto" />
            <!-- Output directory, actions, progress -->
            <RowDefinition Height="Auto" />
            <!-- Log header -->
            <RowDefinition Height="Auto" />
            <!-- Log -->
            <RowDefinition Height="*" MinHeight="110" />
        </Grid.RowDefinitions>

        <Border x:Name="DropZone"
                Grid.Row="0"
                Height="56"
                AllowDrop="True"
                Cursor="Hand"
                BorderThickness="2"
                CornerRadius="6"
                Padding="12,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"
                DragEnter="DropZone_DragEnter"
                DragOver="DropZone_DragOver"
                DragLeave="DropZone_DragLeave"
                Drop="DropZone_Drop"
                MouseLeftButtonUp="DropZone_MouseLeftButtonUp">
            <DockPanel LastChildFill="True" IsHitTestVisible="False">
                <TextBlock DockPanel.Dock="Left" Text="+" FontSize="22" Margin="0,0,12,0"
                           Foreground="#0078D4" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DropZoneText}" ToolTip="{Binding DropZoneText}"
                           FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,10,0,0" Padding="12,10"
                BorderThickness="1" CornerRadius="6"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="88" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Format:" Style="{StaticResource InfoLabelStyle}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PackageFormat}" Style="{StaticResource InfoValueStyle}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Engine:" Style="{StaticResource InfoLabelStyle}" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding PackageEngine}" Style="{StaticResource InfoValueStyle}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Entries:" Style="{StaticResource InfoLabelStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EntryCount}" Style="{StaticResource InfoValueStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Install path:" Style="{StaticResource InfoLabelStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding InstallPath}" ToolTip="{Binding InstallPath}" Style="{StaticResource InfoValueStyle}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Text="{Binding WarningText}"
                           TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" Foreground="#B26A00">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Output to:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="0" Grid.Column="1" Padding="4,3"
                     Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEditPaths}"
                     ToolTip="Editable; Browse keeps the detected app folder under the newly selected parent directory" />
            <Button Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" Padding="14,3"
                    Content="Browse" Click="BrowseOutput_Click" IsEnabled="{Binding CanEditPaths}" />

            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Width="120" Height="28" Content="Start extraction" Command="{Binding StartCommand}" />
                <Button Width="72" Height="28" Margin="10,0,0,0" Content="Cancel"
                        Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}" />
                <Button Height="28" MinWidth="150" Padding="12,3" Margin="10,0,0,0"
                        Content="Open output directory" Command="{Binding OpenOutputCommand}" />
                <Button Width="64" Height="28" Margin="10,0,0,0" Content="About" Click="About_Click" />
            </StackPanel>

            <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding StageText}" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                    <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Text="{Binding StatusText}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </DockPanel>
                <ProgressBar Grid.Row="1" Height="18" Minimum="0" Maximum="100"
                             Tag="{Binding ProgressText, Mode=OneWay}"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Style="{StaticResource ThemedProgressBarStyle}" />
            </Grid>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,12,0,4">
            <Button DockPanel.Dock="Right" Padding="10,2" Content="Clear log"
                    Command="{Binding ClearLogCommand}"
                    ToolTip="Clear the log window" />
            <Button DockPanel.Dock="Right" Margin="0,0,8,0" Padding="10,2" Content="Copy diagnostic information"
                    Command="{Binding CopyDiagnosticCommand}"
                    ToolTip="Copy the full technical details of this extraction to the clipboard" />
            <TextBlock Text="Log" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        </DockPanel>

        <TextBox x:Name="LogBox"
                 Grid.Row="4"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 FontFamily="Consolas"
                 FontSize="12"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Background="{DynamicResource {x:Static SystemColors.ControlLightLightBrushKey}}"
                 Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                 Text="{Binding LogText, Mode=OneWay}"
                 TextChanged="LogBox_TextChanged" />
    </Grid>
</Window>
