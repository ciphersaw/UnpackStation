# ---------------------------------------------------------------
# Track source files and the required local extraction engines only.
# Build intermediates, final binaries and release artifacts stay out.
# ---------------------------------------------------------------

# Local working notes: machine-specific, kept on disk but not tracked
.workbuddy/

# IDE / build intermediates
.vs/
.vscode/
bin/
obj/
/artifacts/
TestResults/
*.user
*.suo
*.userosscache
*.sln.docstates
*.log

# Final binaries and release artifacts
/publish/
/release/
/dist/
*.exe
*.dll
*.pdb
*.dbg
*.cache
*.deps.json
*.runtimeconfig.json
*.runtimeconfig.dev.json
*.dll.config

# Exception: the extraction engines and their licenses are required at runtime
!src/engines/7z/x64/7z.dll
!src/engines/7z/License.txt
!src/engines/innoextract/x64/innoextract.exe
!src/engines/innoextract/LICENSE.txt

# Integration-test samples are generated at runtime by tests/TestFixtures.cs
/tests/Data/
